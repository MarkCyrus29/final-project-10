PORT=5000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/airline?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:5173

# Optional. Used only by `npm run seed:admin`. Without them the public default login
# (admin@airline.com / admin123) is created, which is fine locally but not for a deployed site.
# ADMIN_EMAIL=admin@airline.com
# ADMIN_PASSWORD=choose_a_strong_password
